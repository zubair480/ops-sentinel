# Live You.com retrieval. Leave blank to use verified demo citations.
YOUCOM_API_KEY=

# Live Parasail inference through Agno. Leave blank for deterministic demo analysis.
PARASAIL_API_KEY=
PARASAIL_MODEL=parasail-deepseek-r1
PARASAIL_BASE_URL=https://api.parasail.io/v1

# Live Opsera action dispatch. Leave blank for a verified simulation response.
OPSERA_WEBHOOK_URL=
OPSERA_API_TOKEN=

# Comma-separated browser origins allowed to call FastAPI.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
